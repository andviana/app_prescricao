# Arquivo de exemplo para variáveis de ambiente
# Copie este arquivo para ".env" no seu ambiente local ou configure essas chaves no painel do Render

# Chave secreta da aplicação Flask
SECRET_KEY=uma-chave-secreta-muito-forte-aqui

# URL de Conexão com o Banco de Dados
# Em desenvolvimento local:
DATABASE_URL=sqlite:///app.db

# No Render (usando PostgreSQL), o próprio Render fornecerá uma URL (Internal Database URL) parecida com:
# DATABASE_URL=postgresql://usuariodb:senhadb@servidordb/nombredb
